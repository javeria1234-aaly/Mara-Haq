# ==============================================================
# MERA HAQ - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Rename this file to .env and insert your actual private keys.
# NEVER commit your real .env file with secrets to GitHub!

APP_ENV=production
APP_DEBUG=false
APP_URL=https://merahaq.site

# API Keys (Optional AI Integration)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Settings
DB_CONNECTION=sqlite
DB_DATABASE=data/wirasat.db
